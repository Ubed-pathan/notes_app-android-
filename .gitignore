# React Native - Android
# =====================
android/app/build/
android/.gradle/
android/.cxx/
android/local.properties
android/*.iml
android/*.keystore
.gradle/

# Android release artifacts
android/app/release/*.apk
android/app/release/*.aab
android/app/debug/*.apk

# =================
# React Native - iOS
# =================
ios/build/
ios/Pods/
ios/*.xcworkspace
ios/*.xcodeproj/project.xcworkspace
ios/*.xcodeproj/xcuserdata/
ios/*.xcodeproj/*.pbxuser
ios/*.xcodeproj/*.mode1v3
ios/*.xcodeproj/*.mode2v3
ios/*.xcodeproj/*.perspectivev3
*.xcuserstate
DerivedData/

