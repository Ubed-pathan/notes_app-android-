{
  "expo": {
    "name": "AL-KITAB",
    "slug": "al-kitab",
    "scheme": "al-kitab",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-1024.png",
          "color": "#6750A4",
          "defaultChannel": "reminders-v2-classic_alarm",
          "sounds": [
            "./assets/sounds/classic_alarm.wav",
            "./assets/sounds/soft_chime.wav",
            "./assets/sounds/digital_beep.wav",
            "./assets/sounds/gentle_bell.wav"
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "icon": "./assets/android-legacy-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.notesapp.localnotes",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "USE_FULL_SCREEN_INTENT",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/icon-1024.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b31f5a2d-ce09-4ab1-9931-db5daf63484e"
      }
    },
    "owner": "ubed"
  }
}
